import RPi.GPIO as GPIO
import time

GPIO.setmode(GPIO.BOARD)

while True:
    GPIO.setup(8, GPIO.OUT)
    GPIO.output(8, GPIO.HIGH)
    time.sleep(2)    
    GPIO.output(8, GPIO.LOW)
    time.sleep(2)
