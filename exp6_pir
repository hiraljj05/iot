import RPi.GPIO as GPIO
import time
GPIO.setwarnings(False)
GPIO.setmode(GPIO.BOARD)
GPIO.setup(11, GPIO.IN)
GPIO.setup(3, GPIO.OUT)

while True:
    if GPIO.input(11):
        print("Motion Detected!")
        GPIO.output(3, True)
        time.sleep(1)
    else:
        print("No Motion")
        GPIO.output(3, False)
        time.sleep(1)



